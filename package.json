{
  "name": "personal_control_switch",
  "version": "1.0.0",
  "description": "A desktop dashboard for managing and coordinating multiple Git repositories.",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite dev",
    "preview": "electron-vite preview",
    "test": "node --test",
    "check": "pnpm test && pnpm run build:bundle",
    "build:bundle": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build": "electron-vite build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "42.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide": "1.25.0",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.personal.git-sync",
    "productName": "Git Sync",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "resources/icon.icon",
      "target": "dmg",
      "identity": null,
      "category": "public.app-category.developer-tools"
    }
  }
}
